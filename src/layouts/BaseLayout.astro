---
import '../styles/global.css';

interface Props { title: string; description: string; noindex?: boolean; ogType?: 'website' | 'article' }
const { title, description, noindex = false, ogType = 'website' } = Astro.props;
// File-format builds expose .html in Astro.url; Pages serves the clean URL.
const canonicalPath = Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '');
const canonical = new URL(canonicalPath, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Earnometry" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta name="theme-color" content="#163e32" />
    <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />

    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.earnometryAnalyticsReady = false;
      function gtag(){dataLayer.push(arguments);}

      let analyticsConsent = null;
      try {
        analyticsConsent = localStorage.getItem('earnometry-analytics-consent');
      } catch {}
      window.earnometryAnalyticsConsent = analyticsConsent;

      gtag('consent', 'default', {
        analytics_storage: analyticsConsent === 'granted' ? 'granted' : 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        wait_for_update: 500
      });
      gtag('js', new Date());
      gtag('config', 'G-4X5MF3R8PS');
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-4X5MF3R8PS" onload="window.earnometryAnalyticsReady = true"></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header shell">
      <a class="brand" href="/" aria-label="Earnometry home">
        <svg class="brand-mark" width="32" height="32" viewBox="0 0 48 48" aria-hidden="true"><rect width="48" height="48" rx="12" fill="currentColor"/><path d="M15 13h20v5H21v4h11v5H21v4h14v5H15z" fill="#f8f6ef"/></svg>
        Earnometry<span class="brand-dot" aria-hidden="true">.</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="/tools/youtube-money-calculator" aria-current={canonicalPath === '/tools/youtube-money-calculator' ? 'page' : undefined}>YouTube calculator</a>
        <a href="/tools/sponsorship-rate-calculator" aria-current={canonicalPath === '/tools/sponsorship-rate-calculator' ? 'page' : undefined}>Sponsorship calculator</a>
      </nav>
    </header>
    <main id="main" class="shell" tabindex="-1"><slot /></main>
    <footer class="site-footer shell">
      <div class="footer-top">
        <a class="footer-brand" href="/">Earnometry</a>
        <span>Make sense of the numbers.</span>
        <button type="button" class="cookie-settings" id="cookie-settings">Cookie settings</button>
      </div>
      <p>Earnometry provides estimates for educational and informational purposes only. Results are not financial, legal, tax, or professional advice.</p>
    </footer>

    <section class="analytics-consent" id="analytics-consent" hidden role="dialog" aria-labelledby="analytics-consent-title" aria-describedby="analytics-consent-copy">
      <div class="analytics-consent-copy">
        <strong id="analytics-consent-title">Optional analytics</strong>
        <p id="analytics-consent-copy">We use Google Analytics to understand traffic and improve Earnometry. Analytics is optional and advertising storage stays disabled.</p>
      </div>
      <div class="analytics-consent-actions">
        <button type="button" class="consent-button consent-button-secondary" data-consent="denied">Reject</button>
        <button type="button" class="consent-button consent-button-primary" data-consent="granted">Accept analytics</button>
      </div>
    </section>

    <script is:inline>
      (() => {
        const storageKey = 'earnometry-analytics-consent';
        const banner = document.getElementById('analytics-consent');
        const settings = document.getElementById('cookie-settings');

        const readChoice = () => {
          try {
            return localStorage.getItem(storageKey);
          } catch {
            return null;
          }
        };

        const showBanner = () => {
          if (banner) banner.hidden = false;
        };

        const hideBanner = () => {
          if (banner) banner.hidden = true;
        };

        const applyChoice = (choice) => {
          // Honor the current choice even if storage still holds an older grant.
          window.earnometryAnalyticsConsent = choice;
          try {
            if (typeof window.gtag === 'function') {
              window.gtag('consent', 'update', {
                analytics_storage: choice,
                ad_storage: 'denied',
                ad_user_data: 'denied',
                ad_personalization: 'denied'
              });
            }
          } catch {}

          try {
            localStorage.setItem(storageKey, choice);
          } catch {
            window.earnometryAnalyticsConsent = null;
          }

          hideBanner();
        };

        banner?.querySelectorAll('[data-consent]').forEach((button) => {
          button.addEventListener('click', () => {
            applyChoice(button.dataset.consent === 'granted' ? 'granted' : 'denied');
          });
        });

        settings?.addEventListener('click', () => {
          showBanner();
        });

        if (!readChoice()) showBanner();
      })();
    </script>
    <script>
      import { bindTrackedLinks } from '../lib/analytics';
      bindTrackedLinks();
    </script>
  </body>
</html>
