---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/guide.css';
---
<BaseLayout
  title="Creator Guides | Earnometry"
  description="Practical guides to YouTube earnings, RPM, sponsorships, and creator economics — with clear assumptions and useful calculations."
>
  <section class="guide-index" aria-labelledby="guides-title">
    <a class="back-link" href="/"><span aria-hidden="true">←</span> Home</a>
    <p class="eyebrow">Practical guides</p>
    <h1 id="guides-title">Creator economics,<br />without the guesswork.</h1>
    <p class="lead">Straightforward explanations and worked examples for the numbers behind YouTube revenue and creator income.</p>

    <div class="guide-list">
      <article class="guide-list-card">
        <p class="guide-kicker">YouTube earnings</p>
        <h2><a href="/guides/how-many-youtube-views-to-make-1000">How Many YouTube Views Do You Need to Make $1,000?</a></h2>
        <p>Use RPM to work backward from a $1,000 revenue target. Includes the formula, worked examples, and a calculator for your own assumptions.</p>
        <a class="text-link" href="/guides/how-many-youtube-views-to-make-1000">Read the guide <span aria-hidden="true">→</span></a>
      </article>
    </div>
  </section>
</BaseLayout>
